# ==============================================================================
# VectorCV Backend Environment Configuration Template
# Duplicate this file to .env and replace placeholders with your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas SRV or local connection string)
# Example format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vectorcv?retryWrites=true&w=majority

# Authentication (Random secure secret key, min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here

# OpenRouter AI Configuration
# Obtain your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter Model ID (e.g., google/gemma-2-9b-it:free)
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Frontend Client URL (Configured in CORS allowlist)
CLIENT_URL=http://localhost:5173
